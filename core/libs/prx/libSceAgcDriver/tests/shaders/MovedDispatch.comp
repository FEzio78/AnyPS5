#version 450
layout(local_size_x = 16) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint values[]; } inputs[2];
layout(set = 0, binding = 1, std430) buffer Output { uint values[]; } outputData;
layout(set = 0, binding = 2, std430) readonly buffer Constants { uint value; } constants;
void main() {
    uint index = gl_GlobalInvocationID.x;
    outputData.values[index] = inputs[0].values[index] + inputs[1].values[index] + constants.value;
}
